{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>tuna-os/.github"
  ],
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Reduce CI churn from rapidly moving base-image digests",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "<high-churn-image>"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Wait 7 days before taking a new action release (supply-chain cooldown).",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "7 days"
    }
  ]
}

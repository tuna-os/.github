{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchUpdateTypes": ["major", "minor"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["patch", "pin", "pinDigest", "digest"],
      "automerge": true
    }
  ]
}
